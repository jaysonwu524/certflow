# Local development configuration. Never commit the real .env file.
CERTFLOW_ADDR=:8080
DATABASE_URL=postgres://certflow:certflow@localhost:5432/certflow?sslmode=disable
CERTFLOW_ADMIN_DATABASE_URL=postgres://certflow:certflow@localhost:5432/postgres?sslmode=disable
CERTFLOW_DATABASE_NAME=certflow
CERTFLOW_ENCRYPTION_KEY=
# Created only when no administrator exists yet. These values never overwrite an existing admin.
CERTFLOW_ADMIN_EMAIL=admin@localhost
CERTFLOW_ADMIN_PASSWORD=admin
CERTFLOW_SESSION_TTL_HOURS=8
CERTFLOW_SESSION_IDLE_MINUTES=30
