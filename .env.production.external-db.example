# Copy to .env.production on a server that uses managed PostgreSQL, such as
# Alibaba Cloud RDS. Keep sslmode=require (or verify-full with an installed CA)
# for databases reached through a network.
DATABASE_URL=postgres://certflow:replace-with-password@pgm-xxxxxxxx.rds.aliyuncs.com:5432/certflow?sslmode=require

CERTFLOW_CONTROL_PLANE_IMAGE=ghcr.io/jaysonwu524/certflow-control-plane:latest
CERTFLOW_CONSOLE_IMAGE=ghcr.io/jaysonwu524/certflow-console:latest
CERTFLOW_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
CERTFLOW_ADMIN_EMAIL=admin@example.com
CERTFLOW_ADMIN_PASSWORD=replace-with-a-long-random-password
CERTFLOW_SESSION_TTL_HOURS=8
CERTFLOW_SESSION_IDLE_MINUTES=30

# These are placeholders needed while Compose parses the bundled postgres
# service. That service is disabled by docker-compose.external-db.yml.
POSTGRES_DB=unused
POSTGRES_USER=unused
POSTGRES_PASSWORD=unused
